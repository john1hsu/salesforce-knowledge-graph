    {
      "@id": "kt:event-driven-architecture",
      "@type": "kto:Pattern",
      "skos:prefLabel": "Event-Driven Architecture",
      "skos:definition": "An architectural style in which producers publish events describing state changes to a channel or bus and any number of decoupled consumers react to them asynchronously; on Salesforce it is realized mainly through the event bus, platform events, Change Data Capture and the Pub/Sub API.",
      "kto:domain": "integration",
