    {
      "@id": "kt:account-takeover",
      "@type": "kto:Concept",
      "skos:prefLabel": "Account Takeover",
      "skos:definition": "The threat in which an attacker gains control of a legitimate user's Salesforce login — typically through phishing, vishing or credential stuffing with reused passwords — and then acts with that user's access. It is the main risk that Salesforce MFA, step-up session security and login monitoring are designed to blunt.",
      "kto:domain": "identity",
      "dcterms:created": "2026-11-07",
      "kto:verifiedRelease": "Winter '27",
      "kto:status": "concept",
      "prov:wasDerivedFrom": [
