      "@id": "kt:lookup-vs-master-detail",
      "@type": "kto:Concept",
      "skos:prefLabel": "Lookup vs. Master-Detail Relationships",
      "skos:definition": "The two core one-to-many relationship field types on the Salesforce platform: a loosely coupled lookup that leaves deletion and security independent, and a tightly coupled master-detail in which the parent controls the child's ownership, sharing and deletion and can roll up its values.",
      "kto:domain": "data-model",
      "dcterms:created": "2026-10-30",
      "kto:verifiedRelease": "Winter '27",
      "kto:status": "current",
      "prov:wasDerivedFrom": [
