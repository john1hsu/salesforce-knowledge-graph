      "@id": "kt:data-skew",
      "@type": "kto:AntiPattern",
      "skos:prefLabel": "Data Skew",
      "skos:definition": "A data distribution problem in which a very large number of records concentrate on a single parent record, owner or lookup target, causing record-lock contention and long-running sharing recalculations.",
      "kto:domain": "data-model",
      "dcterms:created": "2026-10-31",
      "kto:verifiedRelease": "Winter '27",
      "kto:status": "current",
