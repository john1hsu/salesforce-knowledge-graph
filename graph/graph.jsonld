      "@id": "kt:multi-factor-authentication",
      "@type": "kto:SecurityControl",
      "skos:prefLabel": "Multi-Factor Authentication",
      "skos:definition": "Salesforce's requirement and built-in capability that users prove their identity with two or more factors at login — a password plus an authenticator app, security key or built-in biometric. Required for UI logins since 2022, enforced for all users from June 2026, with phishing-resistant methods required for privileged users.",
      "kto:domain": "identity",
