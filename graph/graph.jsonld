      "@id": "kt:apex-managed-sharing",
      "@type": "kto:SecurityControl",
      "skos:prefLabel": "Apex Managed Sharing",
      "skos:definition": "Programmatic record sharing in which Apex or the SOAP API inserts rows into an object's share table (for example Job__Share) under a custom Apex sharing reason, granting Read or Edit access that survives ownership changes and can be rebuilt by a batch recalculation class.",
      "kto:domain": "security-and-sharing",
      "dcterms:created": "2026-11-03",
      "kto:verifiedRelease": "Winter '27",
      "kto:status": "current",
