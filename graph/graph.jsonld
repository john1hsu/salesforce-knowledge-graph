    {
      "@id": "kt:governor-limits",
      "@type": "kto:Limit",
      "skos:prefLabel": "Governor Limits",
      "skos:definition": "Runtime limits that the Salesforce platform enforces on every Apex and flow transaction (queries, DML, CPU time, heap, callouts and more) so that one tenant's code cannot monopolize shared multitenant resources.",
      "kto:domain": "platform-architecture",
      "dcterms:created": "2026-10-30",
      "kto:verifiedRelease": "Winter '27",
      "kto:status": "current",
      "prov:wasDerivedFrom": [
