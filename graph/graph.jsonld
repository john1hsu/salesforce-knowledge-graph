    {
      "@id": "kt:fedramp-high",
      "@type": "kto:ExternalConcept",
      "skos:prefLabel": "FedRAMP High",
      "skos:definition": "The most stringent FedRAMP security baseline, for unclassified federal data whose compromise could have a severe or catastrophic effect; built on the NIST SP 800-53 high baseline plus FedRAMP additions, relabelled Class D in 2026, and the level at which Salesforce Government Cloud Plus is authorized.",
      "kto:domain": "public-sector-and-compliance",
      "dcterms:created": "2026-11-03",
      "kto:verifiedRelease": "Winter '27",
      "kto:status": "concept",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "Understanding Baselines and Impact Levels for FedRAMP Authorizations",
          "dcterms:publisher": "FedRAMP (GSA)",
          "schema:url": "https://www.fedramp.gov/rev5/baselines",
          "kto:sourceType": "government"
        },
        {
          "dcterms:title": "Control Baselines for Information Systems and Organizations: NIST Publishes SP 800-53B",
          "dcterms:publisher": "NIST Computer Security Resource Center",
          "schema:url": "https://csrc.nist.gov/news/2020/control-baselines-nist-publishes-sp-800-53b",
          "kto:sourceType": "standards-body"
        },
        {
