    {
      "@id": "kt:principle-of-least-privilege",
      "@type": "kto:Concept",
      "skos:prefLabel": "Principle of Least Privilege",
      "skos:definition": "The security principle that every user, integration, agent and process receives only the access its task requires; in Salesforce it is realised by a minimal baseline profile plus additive permission sets and permission set groups.",
      "kto:domain": "security-and-sharing",
      "dcterms:created": "2026-11-07",
      "kto:verifiedRelease": "Winter '27",
      "kto:status": "concept",
