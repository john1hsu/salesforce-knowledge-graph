      "@id": "kt:trigger-framework-pattern",
      "@type": "kto:Pattern",
      "skos:prefLabel": "Trigger Framework Pattern",
      "skos:definition": "An Apex design pattern in which each object has a single, logic-free trigger that dispatches to handler classes or metadata-registered actions, giving deterministic ordering, bypass controls and testable, reusable trigger logic.",
