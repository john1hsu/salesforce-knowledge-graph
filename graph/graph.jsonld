    {
      "@id": "kt:oauth-2-0",
      "@type": "kto:ExternalConcept",
      "skos:prefLabel": "OAuth 2.0",
      "skos:definition": "The IETF authorization framework (RFC 6749, with bearer-token usage in RFC 6750) that lets a client application obtain limited, scoped access tokens to a protected resource on behalf of a resource owner or itself, without handling the owner's password; it underpins Salesforce API authorization, and its security guidance is now consolidated in RFC 9700 and the in-progress OAuth 2.1 draft.",
      "kto:domain": "identity",
      "dcterms:created": "2026-11-02",
      "kto:verifiedRelease": "Winter '27",
      "kto:status": "concept",
      "prov:wasDerivedFrom": [
        {
          "dcterms:title": "RFC 6749: The OAuth 2.0 Authorization Framework",
          "dcterms:publisher": "IETF / RFC Editor",
          "schema:url": "https://rfc-editor.org/rfc/rfc6749.html",
          "kto:sourceType": "standards-body"
