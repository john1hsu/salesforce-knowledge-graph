    {
      "@id": "kt:roll-up-summary-field",
      "@type": "kto:Feature",
      "skos:prefLabel": "Roll-Up Summary Field",
      "skos:definition": "A read-only custom field on the master side of a master-detail relationship that aggregates related detail records with COUNT, SUM, MIN or MAX, optionally filtered, and is recalculated by the platform during the save process.",
      "kto:domain": "data-model",
      "dcterms:created": "2026-10-31",
      "kto:verifiedRelease": "Winter '27",
      "kto:status": "current",
